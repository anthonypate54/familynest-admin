# Copy this file to `.env` (same directory) and fill in real values.
# NEVER commit the actual `.env` file - it's already gitignored.

# --- PostgreSQL connection ---
# Point this at the real staging/production database. Prefer a
# least-privilege DB user over the main "postgres" superuser where possible.
DB_USER=postgres
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432

# --- Marketing tool restricted DB role ---
# Used only by the marketing query-runner/segment tool. Should point at the
# `marketing_tool` Postgres role (SELECT anywhere, INSERT-only on
# marketing_campaign_export, INSERT/UPDATE on marketing_segment_definitions)
# created by familynest-backend/scripts/marketing/04_create_restricted_role_OPTIONAL.sql
# - NOT the main DB_USER superuser. Falls back to the main DB_* values above
# if unset, which means ad-hoc queries would run as the full app DB user -
# fine for quick local testing, but do not leave unset on staging/production.
MARKETING_DB_USER=marketing_tool
MARKETING_DB_HOST=
MARKETING_DB_NAME=
MARKETING_DB_PASSWORD=
MARKETING_DB_PORT=5432

# --- JWT ---
# Generate a real random secret, e.g.: openssl rand -hex 32
# Do NOT reuse the main Spring Boot backend's JWT_SECRET - this is a
# separate token namespace for admin_users, not app_user.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- Server ---
ADMIN_API_PORT=3001
# Must match the actual origin the React admin app is served from.
CORS_ORIGIN=https://admin.infamilynest.com

# --- Main Spring Boot API ---
# Used by GET /api/users/:id/verify-with-platform to proxy to the Spring
# backend's isolated, read-only AdminSubscriptionVerificationController.
MAIN_API_URL=https://api.infamilynest.com/api

# Shared secret matching the Spring backend's app.admin.api-key /
# AdminAuthFilter.java for whichever environment MAIN_API_URL points at.
MAIN_API_ADMIN_KEY=

# --- Mailchimp ---
# API key from Mailchimp: Profile (bottom-left) > Extras > API keys > Create A Key.
# Format is "<key>-<server prefix>", e.g. "abc123...-us21" - the server
# prefix suffix is required and is parsed out of this value automatically.
MAILCHIMP_API_KEY=

# --- Anthropic (marketing tool "describe in English" -> SQL generation) ---
# Get one at console.anthropic.com > API Keys > Create Key. Optional -
# the marketing tool's SQL query runner works fine without this; it just
# disables the "Generate SQL from English" button in the UI.
ANTHROPIC_API_KEY=
